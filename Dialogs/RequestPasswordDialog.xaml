<Window x:Class="FitTrack.Dialogs.RequestPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitTrack.Dialogs"
        xmlns:component="clr-namespace:FitTrack.Components"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        Height="200" Width="400">
    <Border CornerRadius="15" 
            Background="#FF111944"
            BorderThickness="1"
            BorderBrush="AliceBlue"
            MouseDown="MouseDrag">
        <Grid>
            <Grid Name="CloseGrid" Width="25" Height="25" HorizontalAlignment="Right"
                  MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave"
                  VerticalAlignment="Top" Margin="0,5,5,0">
                <Button x:Name="CloseButton" Style="{StaticResource BlankButton}"
                        Click="Close"/>
                <materialDesign:PackIcon Name="CloseIcon" Kind="Close" 
                                         Foreground="Gray"
                                         Width="25" Height="25"/>
            </Grid>
            <TextBlock Name="TitleBlock" Text="Password Required"
                       Foreground="AliceBlue" FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top"
                       Margin="0,5,0,0"/>
            <StackPanel Margin="10,45,10,10">
                <TextBlock Name="MessageBlock" 
                           Text="Please enter your password to verify it's you"
                           TextWrapping="Wrap"
                           Foreground="AliceBlue" FontSize="15"
                           Height="40"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <component:PasswordBox x:Name="PasswordBox"
                                       Width="250"
                                       FontSize="15"
                                       Margin="0,0,0,20"/>
                <Button Content="Submit" 
                        Style="{StaticResource Button}"
                        Click="Submit"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
