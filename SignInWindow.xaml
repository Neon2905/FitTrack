<Window x:Class="FitTrack.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitTrack"
        xmlns:util="clr-namespace:FitTrack.Utilities"
        xmlns:components="clr-namespace:FitTrack.Components" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
        mc:Ignorable="d"
        Title="SignInWindow" Height="450" Width="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Icon="Resources/Icon.png"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border CornerRadius="10" MouseDown="MouseDrag"
        Background="#272E2F">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="423*"/>
                <ColumnDefinition Width="277*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="430*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="10,10,0,0" Panel.ZIndex="1"
                    MouseDown="MouseDrag" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Height="20">
                    <Button Background="Transparent"
                            BorderThickness="0" 
                            Click="Minimize" 
                            Width="20"
                            Style="{StaticResource WindowMinimizeButton}">
                        <materialDesign:PackIcon Kind="Minimize" Foreground="AntiqueWhite"
                                             Width="20"/>
                    </Button>
                    <Button Background="Transparent"
                            BorderThickness="0" 
                            Click="CloseWindow" 
                            Width="30"
                            Style="{StaticResource WindowCloseButton}">
                        <materialDesign:PackIcon Kind="Close" Foreground="AntiqueWhite" Width="20"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,50,0,70">
                
                <TextBlock Text="Sign Up"
                           FontSize="30"
                           Foreground="AliceBlue"
                           FontWeight="Bold"
                           Margin="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"/>
                
                <StackPanel Height="130" Width="180" 
                            HorizontalAlignment="Left" 
                            Margin="10,0,10,15"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsSigningUp}">
                    <TextBlock Text="{Binding UsernameNotMetRequirementError}"
                           FontSize="10"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Foreground="Red"/>

                    <components:TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,0" FontSize="15"
                                        Placeholder="Username"/>
                    <TextBlock Text="{Binding UsernameAlreadyTakenError}"
                               FontSize="10"
                               Foreground="Red"
                               Margin="0,0,0,6.5"/>
                    <components:TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,20" FontSize="15"
                                        Placeholder="First Name"/>
                    <components:TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,20" FontSize="15"
                                        Placeholder="Last Name (Required)"/>
                    
                </StackPanel>
                
                <StackPanel Height="130" Width="200" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,10,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsSigningUp}">
                    <components:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,20" FontSize="15"
                    Placeholder="Email (Optional)"/>
                    <components:PasswordBox Password="{Binding NewPassword}"
                        Margin="0,0,0,0" FontSize="15"
                        Placeholder="Password"/>
                    <TextBlock Text="{Binding PasswordRequirementsNotMetError}"
                               FontSize="10"
                               Foreground="Red"
                               Margin="0,0,0,6.5"/>
                    <components:PasswordBox Password="{Binding ConfirmPassword}"
                        Margin="0,0,0,0" FontSize="15"
                        Placeholder="Confirm password"/>
                    <TextBlock Text="{Binding PasswordsNotMatchError}" 
                               Foreground="Red"
                               FontSize="10"
                               Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,180,0,0">
                    <RadioButton Content="Male" Foreground="AliceBlue" Margin="0,0,10,0"
                                 Command="{Binding SetMaleCommand}"/>
                    <RadioButton Content="Female" Foreground="AliceBlue"  Margin="0,0,10,0"
                                 Command="{Binding SetFemaleCommand}"/>
                    <RadioButton Content="Other" Foreground="AliceBlue"
                                 Command="{Binding SetOtherCommand}"
                                 IsChecked="True"/>
                </StackPanel>
                
                <TextBlock Text="{Binding PasswordLengthNotMetError}"
                           FontSize="10"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"
                           Foreground="Red"/>

                <Button Style="{StaticResource Button}"
                        Content="Sign Up" 
                        VerticalAlignment="Bottom"
                        IsEnabled="{Binding CanSignUp}"
                        Command="{Binding SignUpCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

            </Grid>

            <Grid Grid.Row="1"
              Grid.Column="1">
                <StackPanel Margin="0,80,0,100" Width="180"
                            IsEnabled="{Binding IsSigningUp, Converter={StaticResource InverseBooleanConverter}}">

                    <TextBlock Text="Log In"
                           FontSize="30"
                           Foreground="AliceBlue"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                    <components:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,25,0,10" 
                                        FontSize="15"
                                        Placeholder="Username"/>
                    <components:PasswordBox 
                        Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="15"/>
                    <Button Content="Sign in"
                        Margin="30"
                        Style="{StaticResource Button}"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        IsEnabled="{Binding CanSignIn}"/>
                    <TextBlock Text="Forgot Password?"
                       FontSize="15"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,150,0,0"/>

                </StackPanel>
                <TextBlock Text="{Binding InvalidLoginError}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FFB35D5D"
                           FontFamily="Arial"/>

            </Grid>

            <!--SignUp Mask-->
            <Border CornerRadius="10,0,0,10" Grid.RowSpan="2"
                    Background="#FF2D472D" Grid.Column="0"
                    Visibility="{Binding IsSigningUp, 
                                Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid Margin="10">
                    <TextBlock Text="Don't Have An Account?" FontSize="20" Foreground="AliceBlue"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,100"/>
                    <Button Content="Sign Up" Command="{Binding SignUpViewCommand}"
                            Style="{StaticResource Button}"/>
                </Grid>
            </Border>

            <!--SignIn Mask-->
            <Border CornerRadius="0,10,10,0" Grid.RowSpan="2" 
                    Background="#FF615836" Grid.Column="1"
                    Visibility="{Binding IsSigningUp, 
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid  Margin="10">
                    <TextBlock Text="Already Have An Account?" FontSize="20" Foreground="AliceBlue"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,100"/>
                    <Button Content="Sign In" Command="{Binding SignInViewCommand}"
                        Style="{StaticResource Button}"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
